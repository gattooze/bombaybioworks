# Claude API key (Anthropic console). Spend cap: set a monthly limit in the console.
ANTHROPIC_API_KEY=
# Models: Haiku for both by default. ANSWER_MODEL=claude-sonnet-5-5 for better replies at ~20x the cost.
EXTRACT_MODEL=claude-haiku-5-5
ANSWER_MODEL=claude-haiku-5-5

# Hivemind MCP server. The secret is in Secret Manager: hivemind-mcp-secret.
HIVEMIND_MCP_URL=https://hivemind-mcp-849464697051.asia-south1.run.app/mcp
HIVEMIND_MCP_SECRET=

# Founders' WhatsApp numbers with country code, comma separated. Only they can instruct Hive.
FOUNDER_PHONES=
# Keep true until Hive runs on its own number. true = extract only, never reply.
READ_ONLY=true

# Firebase Admin SDK (only for storing the WhatsApp session in Firestore)
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
FIREBASE_PROJECT_ID=bombay-bioworks
USE_FIRESTORE_AUTH=false

# The WhatsApp group JID. Run `npm run groups` after linking to find it. Format: 123-456@g.us
GROUP_JID=

# Optional
GROUP_NAME=Bombay Bioworks
SESSION_DIR=./sessions
DB_PATH=./data/state.db
TRIGGER_PREFIX=@hive
