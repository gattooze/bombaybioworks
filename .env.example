# Required — free from https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ....

# Firebase Admin SDK — download from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → save as serviceAccount.json in this directory
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
FIREBASE_PROJECT_ID=bombay-bioworks

# The WhatsApp group JID — run `npm run groups` after first QR scan to find it
# Format: 1234567890-1234567890@g.us
GROUP_JID=

# Optional
GROUP_NAME=Bombay Bioworks
SESSION_DIR=./sessions
# SQLite used only for processing state (progress tracking, offline queue)
DB_PATH=./data/state.db
# Trigger prefix to answer questions in group (default: @hive)
TRIGGER_PREFIX=@hive
